{
  "items": [
    { "kind": "agent", "id": "discovery-scout" },
    { "kind": "agent", "id": "discovery-asker" },
    { "kind": "agent", "id": "discovery-debrief" }
  ],
  "zones": [
    { "key": "discovery", "name": "Discovery", "dx": 0, "dy": 0, "w": 600 },
    {
      "key": "debrief", "name": "Debrief", "dx": 640, "dy": 0, "w": 440,
      "rule": { "when": { "kind": "anything" }, "run": { "agent": "discovery-debrief" }, "into": "calls" }
    },
    {
      "key": "calls", "name": "Calls", "dx": 1120, "dy": 0, "w": 600,
      "rule": { "when": { "kind": "data", "field": "followUp", "op": "=", "value": "yes" }, "run": { "agent": "discovery-asker" }, "into": "followups" }
    },
    { "key": "followups", "name": "Follow-ups", "dx": 1760, "dy": 0, "w": 440 }
  ],
  "pages": [
    { "zone": "discovery", "title": "Discovery board", "file": "board.html", "dx": 16, "dy": 48, "width": "wide" }
  ]
}
