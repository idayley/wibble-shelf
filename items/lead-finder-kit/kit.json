    },
    {
      "key": "leads", "name": "Leads", "shows": "board", "dx": 940, "dy": 0, "w": 1020, "h": 720,
      "rule": {
        "when": { "kind": "clock", "clock": { "repeat": "weekly", "days": ["mon"], "time": "08:00" } },
        "run": { "agent": "lead-scout", "note": "Monday re-run. Search only: re-run the saved searches on the lead board and add only people who are not on it yet. Never reveal or spend." },
        "into": "leads",
        "missed": "skip"
      }
    },
    {
      "key": "outreach", "name": "Outreach", "shows": "board", "dx": 0, "dy": 760, "w": 900, "h": 340,
      "rule": { "when": { "kind": "anything" }, "run": { "agent": "outreach-asker" }, "into": "send" }
    },
    { "key": "send", "name": "To send", "shows": "board", "dx": 940, "dy": 760, "w": 1020, "h": 340 }
  ],
